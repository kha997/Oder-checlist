{
  "name": "oder-checklist",
  "private": true,
  "version": "1.0.0",
  "description": "Mobile-first order checklist & delivery management app for online sellers and condominium deliveries.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dev-dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project demo-oder-checklist \"node scripts/verify-firestore-rules.mjs\"",
    "test:palette": "node scripts/verify-oklch-palette.mjs",
    "icons": "node scripts/generate-icons.js",
    "verify": "npm run typecheck && npm run test && npm run test:rules && npm run build && npm run test:palette"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  }
}
